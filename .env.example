# Copy this file to .env and fill in values for local development.
# This file is ignored by git (.gitignore includes .env)

# Backend HTTP port
PORT=8080

# MongoDB Connection
# Option A: Full MongoDB URI (recommended)
# Examples:
# - Local: mongodb://localhost:27017/homeschool-keeper
# - Docker: mongodb://mongo:27017/homeschool-keeper
# - Atlas: mongodb+srv://user:pass@cluster0.abcd.mongodb.net/homeschool-keeper?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/homeschool-keeper

# Option B: Split parts (used only if MONGODB_URI is empty)
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_HOST=localhost:27017
# MONGO_DB=homeschool-keeper

# JWT Secret (generate a secure random string for production)
# Example: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production

# JWT Token Expiry (for mobile auth)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h  # 7 days

# Session Secret for web cookie auth (REQUIRED - minimum 32 characters)
# Example: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-at-least-32-characters-long

# Encryption Master Key for PII encryption (REQUIRED - minimum 32 characters)
# Used for encrypting sensitive data like date of birth
# Example: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=dev-encryption-key-at-least-32-characters-long

# Optional: Google OAuth (for future social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# ===========================================
# Cloudflare R2 Storage (for work sample uploads)
# ===========================================
# See docs/15-r2-setup.md for setup instructions

# Required for R2 integration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hsmlogs

# Optional: Custom domain for R2 public access
# R2_CUSTOM_DOMAIN=https://files.yourdomain.com

# Pre-signed URL expiration times
R2_UPLOAD_URL_EXPIRY=5m
R2_DOWNLOAD_URL_EXPIRY=1h

# Maximum file size for uploads (in MB)
MAX_UPLOAD_SIZE_MB=10

# ===========================================
# Premium Features
# ===========================================
# These are controlled per-family in the database
# Default behavior for new families:
DEFAULT_SYNC_ENABLED=false
DEFAULT_UPLOADS_ENABLED=false

# Development mode (enables additional logging)
DEV_MODE=true
