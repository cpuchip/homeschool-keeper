# Copy this file to .env and fill in values for local development.
# This file is ignored by git (.gitignore includes .env)

# Backend HTTP port
PORT=8080

# MongoDB Connection
# Option A: Full MongoDB URI (recommended)
# Examples:
# - Local: mongodb://localhost:27017/homeschool-keeper
# - Docker: mongodb://mongo:27017/homeschool-keeper
# - Atlas: mongodb+srv://user:pass@cluster0.abcd.mongodb.net/homeschool-keeper?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/homeschool-keeper

# Option B: Split parts (used only if MONGODB_URI is empty)
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_HOST=localhost:27017
# MONGO_DB=homeschool-keeper

# JWT Secret (generate a secure random string for production)
# Example: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production

# JWT Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h  # 7 days

# Optional: Google OAuth (for future social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Optional: File Storage
# FILE_STORAGE_PATH=./uploads
# MAX_FILE_SIZE_MB=10

# Optional: Encryption key for file storage (32 bytes, base64 encoded)
# FILE_ENCRYPTION_KEY=

# Development mode (enables additional logging)
DEV_MODE=true
